# Copy to .env for local dev. `npm run setup` creates .env automatically if absent.

# App runtime connection: restricted role, subject to Row-Level Security.
DATABASE_URL="postgresql://app_user:app_user_password@localhost:5432/resto_saas?schema=public"

# Migration/owner connection: used only by `prisma migrate` and seeding. Owns the
# tables and is therefore exempt from RLS by default (see prisma/migrations for
# the RLS policies) -- never expose this URL to the running application.
DIRECT_DATABASE_URL="postgresql://app_migrator:app_migrator_password@localhost:5432/resto_saas?schema=public"

# 32+ byte random secret used to sign session JWTs. Generate with:
#   openssl rand -base64 48
SESSION_SECRET="change-me-in-every-environment-min-32-chars-long"

NODE_ENV="development"

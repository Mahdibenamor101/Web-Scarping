# Copy to .env for local dev. `npm run setup` creates .env automatically if absent.

# App runtime connection: restricted role, subject to Row-Level Security.
DATABASE_URL="postgresql://app_user:app_user_password@localhost:5432/resto_saas?schema=public"

# Migration/owner connection: used only by `prisma migrate` and seeding. Owns the
# tables and is therefore exempt from RLS by default (see prisma/migrations for
# the RLS policies) -- never expose this URL to the running application.
DIRECT_DATABASE_URL="postgresql://app_migrator:app_migrator_password@localhost:5432/resto_saas?schema=public"

# 32+ byte random secret used to sign session JWTs. Generate with:
#   openssl rand -base64 48
SESSION_SECRET="change-me-in-every-environment-min-32-chars-long"

NODE_ENV="development"

# Stripe (Phase 0 étape 5 -- billing, and customer order payment, see
# CONTEXT.md). All three optional: if unset, the billing routes AND the
# public "Payer en ligne" button both return a clean 501/hide themselves,
# so `npm run setup` keeps working fully without a real Stripe account.
# Use TEST MODE keys from https://dashboard.stripe.com/test/apikeys --
# never live keys in local dev. Same single Stripe account is used for
# both the org's own subscription AND every customer order payment --
# funds from the latter settle into the PLATFORM's balance, not the
# restaurant's. Fine for this pass (never tested against a real account
# either way); a real launch needs Stripe Connect so each organization's
# order payments route to their own connected account.
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_PRICE_ID="price_..."         # the single ~400€/an plan, see CONTEXT.md §8
# STRIPE_WEBHOOK_SECRET="whsec_..."   # from `stripe listen --print-secret` locally

# Email (staff invites). Both optional: if either is unset, sendEmail()
# logs and returns { sent: false } instead of throwing -- invite links
# still work exactly as before, just handed over manually. Get an API key
# from https://resend.com, and EMAIL_FROM must be a verified sender/domain
# on that account.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="mbQr <hello@mbqr.app>"

# Google sign-in. Both optional: if either is unset, the "Continuer avec
# Google" button (login/signup) redirects back with a clear "indisponible"
# message instead of crashing. Create credentials at
# https://console.cloud.google.com/apis/credentials -- the authorized
# redirect URI must be exactly "{your app's origin}/api/auth/google/callback"
# (derived from the incoming request at runtime, same as staff invite
# links -- no separate base-URL env var to keep in sync).
# GOOGLE_CLIENT_ID="....apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="GOCSPX-..."

# Sign in with Apple. All four optional, same graceful-degrade pattern.
# Requires a paid Apple Developer account: a Services ID (=APPLE_CLIENT_ID),
# a Sign in with Apple key (APPLE_KEY_ID + its downloaded .p8 private key),
# and your Team ID. Redirect URI must be exactly
# "{your app's origin}/api/auth/apple/callback". APPLE_PRIVATE_KEY is the
# full .p8 file contents, with real newlines escaped as \n if set via a
# single env line (e.g. in a hosting provider's dashboard).
# APPLE_CLIENT_ID="com.mbqr.web"
# APPLE_TEAM_ID="..."
# APPLE_KEY_ID="..."
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Menu translation (FR/DE/ES/PT beyond the manual IT/EN fields), optional:
# if unset, POST /api/menu/translate returns a clean 501 and the dashboard
# "Traduction automatique" panel shows a not-configured message. Get a free
# or paid key from https://www.deepl.com/pro-api -- free-tier keys end in
# ":fx" and are detected automatically to hit the correct API host.
# DEEPL_API_KEY="...:fx"

# AI-generated food photos ("Générer avec l'IA" in the menu item form),
# optional: if unset, POST /api/menu/generate-photo returns a clean 501.
# Also requires the S3 storage block below (the generated image has to be
# persisted somewhere permanent). Get a key from https://platform.openai.com.
# OPENAI_API_KEY="sk-..."

# Photo storage (menu items), S3-compatible (works with Cloudflare R2,
# Supabase Storage, AWS S3, MinIO...). All four optional: if any is unset,
# POST /api/menu/items/[itemId]/photo returns a clean 501, and the
# existing manual photoUrl field keeps working. S3_PUBLIC_URL_BASE is the
# base your bucket serves files from publicly (e.g. R2's public bucket URL
# or a CDN in front of it) -- not necessarily the same host as the endpoint.
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_BUCKET="mbqr-menu-photos"
# S3_ACCESS_KEY_ID="..."
# S3_SECRET_ACCESS_KEY="..."
# S3_PUBLIC_URL_BASE="https://photos.mbqr.app"
